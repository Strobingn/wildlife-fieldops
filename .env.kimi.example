# =============================================================================
# Kimi AI Assistant Configuration
# =============================================================================
# This file configures the Kimi AI assistant integration for FieldOps.
# Copy to .env.kimi and fill in your credentials.
#
# Kimi is an AI assistant by Moonshot AI that provides intelligent
# assistance for wildlife removal operations.
#
# Get your API key at: https://platform.moonshot.cn/
# =============================================================================

# Your Kimi API key (required)
KIMI_API_KEY=your-kimi-api-key-here

# Kimi API base URL
# Default: https://api.moonshot.cn
# For enterprise/on-premise deployments, change this to your instance URL
KIMI_BASE_URL=https://api.moonshot.cn

# Model to use for completions
# Options: kimi-latest, kimi-k1, kimi-k1.5, kimi-k2
# Default: kimi-latest
KIMI_MODEL=kimi-latest

# Maximum tokens per response
# Range: 256 - 8192
# Default: 4096
KIMI_MAX_TOKENS=4096

# Temperature for response creativity
# Range: 0.0 - 1.0 (lower = more deterministic)
# Default: 0.7
KIMI_TEMPERATURE=0.7

# System prompt for the wildlife assistant
# Customize to adjust the AI's personality and expertise
KIMI_SYSTEM_PROMPT="You are the Wildlife Whisperer AI assistant, an expert in wildlife removal operations. You help technicians with species identification, removal strategies, safety protocols, regulatory compliance, and customer communication. You have deep knowledge of North American wildlife behavior, trapping techniques, exclusion methods, and repair best practices. Always prioritize safety, humane treatment of animals, and legal compliance. Respond concisely and practically for field use."

# Enable streaming responses for faster perceived performance
# Default: true
KIMI_STREAMING=true

# Request timeout in milliseconds
# Default: 30000 (30 seconds)
KIMI_TIMEOUT_MS=30000

# Enable conversation history
# Default: true
KIMI_ENABLE_HISTORY=true

# Maximum conversation history length
# Default: 20
KIMI_MAX_HISTORY=20

# =============================================================================
# Feature Flags
# =============================================================================
# Enable AI-powered job notes generation
KIMI_FEATURE_JOB_NOTES=true

# Enable AI-powered species identification assistance
KIMI_FEATURE_SPECIES_ID=true

# Enable AI-powered estimate suggestions
KIMI_FEATURE_ESTIMATES=true

# Enable AI-powered customer communication drafts
KIMI_FEATURE_CUSTOMER_COMMS=true

# Enable AI-powered safety reminders
KIMI_FEATURE_SAFETY=true

# =============================================================================
# Rate Limiting (to control API costs)
# =============================================================================
# Maximum requests per minute
KIMI_RATE_LIMIT_PER_MINUTE=10

# Maximum requests per day
KIMI_RATE_LIMIT_PER_DAY=100

# Maximum tokens per day
KIMI_DAILY_TOKEN_LIMIT=100000
