# =============================================================================
# Wildlife Whisperer FieldOps — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it contains secrets.
#
# DEVELOPMENT:
#   1. cp .env.example .env
#   2. Fill in all required values below
#   3. npm run dev
#
# PRODUCTION:
#   Set these as secrets in your CI/CD pipeline (GitHub Actions, Cloudflare, etc.)
#   Do NOT use a .env file in production builds.
#
# REQUIRED: These values are needed for the app to function.
# OPTIONAL: These enhance functionality but the app will work without them.
# =============================================================================

# =============================================================================
# SUPABASE (REQUIRED)
# =============================================================================
# Your Supabase project URL (found in Project Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous/public API key (NOT the service role key)
# Found in Project Settings > API > Project API keys
VITE_SUPABASE_ANON_KEY=your-anon-key

# =============================================================================
# GOOGLE MAPS (REQUIRED for GPS/map features)
# =============================================================================
# Google Maps JavaScript API key
# Get one at: https://developers.google.com/maps/documentation/javascript/get-api-key
VITE_GOOGLE_MAPS_API_KEY=your-maps-api-key

# =============================================================================
# GOOGLE CALENDAR (OPTIONAL — enables calendar sync)
# =============================================================================
# Google OAuth2 Client ID for Calendar API
# Create at: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Google API Key (for Calendar API discovery)
VITE_GOOGLE_API_KEY=your-google-api-key

# =============================================================================
# OPENWEATHERMAP (OPTIONAL — enables weather display)
# =============================================================================
# OpenWeatherMap API key
# Get one at: https://openweathermap.org/api
VITE_OPENWEATHER_API_KEY=your-openweather-key

# =============================================================================
# KIMI AI ASSISTANT (OPTIONAL — enables AI features)
# =============================================================================
# Your Kimi API key for AI assistant functionality
VITE_KIMI_API_KEY=your-kimi-api-key

# Kimi API base URL (change for enterprise deployments)
VITE_KIMI_BASE_URL=https://api.moonshot.cn

# Kimi model to use for chat completions
VITE_KIMI_MODEL=kimi-latest

# =============================================================================
# PUSH NOTIFICATIONS (OPTIONAL — enables push notifications)
# =============================================================================
# VAPID public key for web push notifications
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# =============================================================================
# ANALYTICS (OPTIONAL)
# =============================================================================
# Google Analytics 4 Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# APP CONFIGURATION (OPTIONAL — override defaults)
# =============================================================================
# App environment: development | staging | production
VITE_APP_ENV=development

# Enable debug logging
VITE_DEBUG=false

# Default tax rate (decimal, e.g., 0.08 = 8%)
VITE_DEFAULT_TAX_RATE=0.08

# Company info for PDF headers
VITE_COMPANY_NAME=Wildlife Whisperer LLC
VITE_COMPANY_PHONE=(555) 123-4567
VITE_COMPANY_EMAIL=info@wildlifewhispererllc.com
VITE_COMPANY_ADDRESS=123 Forest Way
VITE_COMPANY_CITY=Wildwood
VITE_COMPANY_STATE=FL
VITE_COMPANY_ZIP=34785
