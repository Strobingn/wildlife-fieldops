# Wildlife FieldOps — Environment Variables
# ==========================================
#
# Copy this file to .env OR put the same keys in local.properties
# Keys are only used at build time. They never appear in committed source.
#
# Android build now loads (in order):
#   1. process environment
#   2. local.properties (project root or app/)
#   3. .env
#
# ==========================================

# --- SUPABASE (Database + Storage + Auth) ---
# supabase.com → Project → Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Legacy web names still accepted:
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# --- GOOGLE MAPS (Maps SDK for Android) ---
# console.cloud.google.com → APIs & Services → Credentials
# 1. Enable "Maps SDK for Android"
# 2. Restrict the key to Android apps
# 3. Package name: com.strobingn.wildlifefieldops
# 4. Add the SHA-1 of your debug/release keystore
GOOGLE_MAPS_API_KEY=AIzaSy...

# Also accepted (legacy / web copy-paste):
# VITE_GOOGLE_MAPS_API_KEY=AIzaSy...
# MAPS_API_KEY=AIzaSy...

# --- OPENWEATHER (optional weather on job cards) ---
OPENWEATHER_API_KEY=

# --- XAI / LLM (optional) ---
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.5
