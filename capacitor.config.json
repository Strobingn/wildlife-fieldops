{
  "appId": "com.strobingn.wildlifefieldops",
  "appName": "Wildlife Whisperer FieldOps",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "hostname": "wildlifewhispererllc.com",
    "iosScheme": "https",
    "allowNavigation": [
      "*.google.com",
      "*.googleapis.com",
      "*.supabase.co",
      "*.supabase.in"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#0a0a0f",
    "overrideUserAgent": null,
    "appendUserAgent": "FieldOps-Android/3.0.0",
    "buildOptions": {
      "keystorePath": "wildlife-whisperer.keystore",
      "keystorePassword": "${KEYSTORE_PASSWORD}",
      "keystoreAlias": "wildlife-whisperer",
      "keystoreAliasPassword": "${KEYSTORE_ALIAS_PASSWORD}"
    }
  },
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#0a0a0f",
    "scrollEnabled": true,
    "appendUserAgent": "FieldOps-iOS/3.0.0"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0f",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#0a0a0f",
      "animation": "slide"
    },
    "Keyboard": {
      "resize": "body",
      "style": "dark",
      "resizeOnFullScreen": true
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config",
      "iconColor": "#22c55e"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "App": {
      "deepLinking": {
        "enabled": true,
        "prefixes": [
          "fieldops://",
          "https://wildlifewhispererllc.com/fieldops"
        ]
      }
    },
    "Camera": {
      "allowEditing": false,
      "saveToGallery": true
    },
    "Geolocation": {
      "timeout": 10000,
      "maximumAge": 60000,
      "enableHighAccuracy": true
    }
  }
}
